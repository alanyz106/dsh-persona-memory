{
  "name": "dsh-persona-memory",
  "version": "0.3.3",
  "description": "Persistent long-term persona memory for DeepSeek Harness: MEMORY.md/USER.md global stores plus repository-local project memory (AGENTS.md index + memory/ topic files), memory / memory_search / project_memory tools, per-request context injection, secret scanning, and a WebUI memory-management settings page.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quophic/dsh-persona-memory.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "memory",
    "persistent-memory",
    "persona",
    "long-term-memory"
  ],
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh-session": "0.2.1-rc.2",
      "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
      "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
      "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
      "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
      "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2"
    }
  }
}
