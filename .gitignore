# dependencies / local junctions (host copies for tests)
node_modules/

# pnpm store cache (local)
.pnpm-store/

# build output — generated from TypeScript sources (tsc + esbuild)
dist/
client/client.js

# stray runtime logs (restart helper logs to ~/.dsh/web-logs now)
.web/

# npm
*.tgz

# vision toolkit runtime temp (pasted images etc.)
.dsh-vision-toolkit/

# 项目记忆（本地笔记，不进仓库 / 不进 npm 包）
# AGENTS.md = 常驻规则 + @memory/*.md 索引；memory/ = 具体记忆内容。
# 靠 ~/.dsh/memory-backup/{latest,history}/ 保护，见 memory/publish-todo.md
/AGENTS.md
/memory/

# npm lockfile: the plugin installs through pnpm (dsh plugin add) — an
# npm lock would freeze the peer-resolution CI wants to keep loose.
package-lock.json
